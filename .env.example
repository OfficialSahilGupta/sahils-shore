# -----------------------------------------------------------------------------
# Sahil's Shore — Environment Variables Example
# Duplicate this file to `.env.local` for local development.
# NEVER commit real secret keys to source control.
# -----------------------------------------------------------------------------

# Supabase Public Configuration
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Supabase Service Role Key (Server-side only — NEVER expose to the browser)
# Used for server-side administrative actions, scheduled jobs, and backups
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Single-User Lock Configuration
# Only this Google account email will be permitted to access Sahil's Shore.
# Any other authenticated Google account will be rejected immediately at callback.
ALLOWED_EMAIL=sahil@example.com

# Application URL
# Used for generating OAuth redirect callbacks in local dev and production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Drive API v3 Configuration (Phase 7)
# Created in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/drive/callback

# (Optional) Secret key used to encrypt OAuth refresh tokens at rest with AES-256-GCM.
# Defaults to a hash of SUPABASE_SERVICE_ROLE_KEY if omitted.
DRIVE_ENCRYPTION_KEY=a-random-32-byte-hex-or-passphrase-string

# AI Coach Configuration (Phase 11)
# Server-side API key for AI Coach insights. Support either GEMINI_API_KEY or ANTHROPIC_API_KEY.
# If omitted or unconfigured, an intelligent offline heuristic engine generates insights locally.
GEMINI_API_KEY=your-gemini-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
