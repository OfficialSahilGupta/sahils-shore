# -----------------------------------------------------------------------------
# Sahil's Shore — Environment Variables Example
# Duplicate this file to `.env.local` for local development.
# NEVER commit real secret keys to source control.
# -----------------------------------------------------------------------------

# Supabase Public Configuration
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Supabase Service Role Key (Server-side only — NEVER expose to the browser)
# Used for server-side administrative actions, scheduled jobs, and backups
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Single-User Lock Configuration
# Only this Google account email will be permitted to access Sahil's Shore.
# Any other authenticated Google account will be rejected immediately at callback.
ALLOWED_EMAIL=sahil@example.com

# Application URL
# Used for generating OAuth redirect callbacks in local dev and production
NEXT_PUBLIC_APP_URL=http://localhost:3000
